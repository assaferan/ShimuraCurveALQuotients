// The complete solution set of the Thue-Mahler equation
//     8 X^5 + X^4 Y + 90 X^3 Y^2 - 239 X^2 Y^3 + 128 X Y^4 + 16 Y^5  =  +- 2^z1 7^z2 11^z3 13^z4,
// gcd(X, Y) = 1, as returned by Gherga-Siksek's solver (github.com/adelagherga/ThueMahler,
// Code/TMSolver/solveThueMahler.m, called with coprime := false so that gcd(8, Y) is unrestricted),
// in 237 s.  Each entry is [X, Y, z1, z2, z3, z4]; the degree being odd, (X, Y) and (-X, -Y) are
// the same solution and one representative is listed.  stepH-thuemahler.m checks every entry.
[
    [ 4, 3, 5, 1, 0, 1 ],
    [ 8, 7, 4, 0, 1, 2 ],
    [ 12, -5, 5, 4, 1, 1 ],
    [ 3, 1, 4, 0, 0, 2 ],
    [ -1, 17, 6, 1, 1, 3 ],
    [ 1, -4, 2, 2, 0, 2 ],
    [ 1, -1, 6, 1, 0, 0 ],
    [ 1, 1, 2, 0, 0, 0 ],
    [ 17, 23, 11, 3, 0, 2 ],
    [ 3, 2, 1, 2, 0, 1 ],
    [ 24, -5, 4, 3, 2, 2 ],
    [ 5, 4, 2, 0, 3, 0 ],
    [ 1, 0, 3, 0, 0, 0 ],
    [ 5, 3, 11, 0, 1, 0 ],
    [ 2, 1, 2, 1, 1, 0 ],
    [ 1, -8, 7, 1, 1, 1 ],
    [ 0, 1, 4, 0, 0, 0 ],
    [ 9, -1, 10, 2, 1, 0 ],
    [ 1, 3, 4, 2, 1, 0 ],
    [ 19, 15, 2, 2, 1, 3 ],
    [ 2, -1, 2, 2, 1, 0 ]
]
