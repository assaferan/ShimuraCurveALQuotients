// Built 2026-10-03 as fibre products over the star line of committed double covers
// (FibreProductCovers.m); each verified against the trace formula at up to three primes, F_p and F_{p^2}.
// Coordinates s, z of weight 1; y_i of weight half the degree of its own equation.
models[[Integers()|1,10]] := [* <4, "CRV", [ Strings() | "-1/4*s^6 + 1/2*s^4*z^2 + 5*s^3*z^3 + 11/4*s^2*z^4 - s*z^5 - 15*z^6 + y1^2", "19/4*s^6 + 8*s^5*z + 29/2*s^4*z^2 - 39*s^3*z^3 - 177/4*s^2*z^4 - 45*s*z^5 + 125*z^6 + y2^2" ]> *];
