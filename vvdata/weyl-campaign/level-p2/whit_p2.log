  order p^-1, ord_p t_mu = 0   : 4    cosets, alpha_0..4 = [ 1, 0, 0, 0, 0 ]
      (1-X)G = -X + 1
  order p^-1, ord_p t_mu = 1   : 2    cosets, alpha_0..4 = [ 1, 3, 3, 3, 3 ]
      (1-X)G = -3*X^5 + 2*X + 1
  order p^-1, ord_p t_mu = inf : 2    cosets, alpha_0..4 = [ 1, 3, 3, 3, 3 ]
      (1-X)G = -3*X^5 + 2*X + 1
  order p^-2, ord_p t_mu = 0   : 6    cosets, alpha_0..4 = [ 1, 1, 1, 1, 1 ]
      (1-X)G = -X^5 + 1
  order p^-2, ord_p t_mu = inf : 6    cosets, alpha_0..4 = [ 1, 1, 1, 1, 1 ]
      (1-X)G = -X^5 + 1

