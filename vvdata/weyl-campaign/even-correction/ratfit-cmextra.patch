         end for;
         M := Matrix(M);
         B :=  Basis(Kernel(Transpose(M)));
+        // ===== PROBE_RATFIT (throwaway branch; never merge) =====
+        // The "no solution found" error raised in QuadraticConstraintsOnEquations tests THIS
+        // kernel, not anything the quadratic stage computes.  Report why it is empty.
+        if GetEnv("PROBE_RATFIT") ne "" then
+            printf "RATFIT key %o W=%o g=%o #ds=%o #svals=%o #rat=%o #quad=%o dimB=%o\n",
+                keys_fs[idx], Sort([w : w in curves[keys_fs[idx]]`W]), g, #ds, #svals,
+                #rat_svals, #svals-#rat_svals, #B;
+            for e in [0..6] do
+                Me := Matrix([[Rationals()!(s)^i : i in [0..2*g+2+e]]
