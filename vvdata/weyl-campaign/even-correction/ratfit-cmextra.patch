     genus_list := [curves[i]`g: i in aeac_keys];
     num_vals := Maximum([2*g+5 : g in genus_list]);
+    // ===== CMEXTRA (throwaway branch; never merge) -- THE LIVE CALL SITE =====
+    // AllEquationsAboveCovers has its OWN copy of the num_vals computation; the one in
+    // EquationsOfCovers (the "[4/6]" path) is not on this driver's path at all.
+    if GetEnv("CMEXTRA") ne "" then
+        num_vals +:= StringToInteger(GetEnv("CMEXTRA"));
+    end if;
+    printf "CMEXTRA num_vals = %o\n", num_vals;
+    // ===== end CMEXTRA =====
     vprintf ShimuraQuotients, 1 : "Computing absolute values at CM points...";
     abs_schofer_tab, all_cm_pts:= AbsoluteValuesAtCMPoints(Xstar, curves, all_cm_pts, fs :
                                                            MaxNum := num_vals, Prec := Prec,
