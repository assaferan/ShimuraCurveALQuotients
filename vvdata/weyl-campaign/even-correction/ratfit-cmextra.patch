@@ -315,6 +335,17 @@ intrinsic EquationsOfCovers(Xstar::ShimuraQuot, curves::SeqEnum[ShimuraQuot] : P
 
     // num_vals := Maximum([2*g+4 : g in genus_list]); // This is what we need for the equation part, but
     num_vals := Maximum([2*g+5 : g in genus_list]); // This is what we need for finding the y2 scales
+    // ===== CMEXTRA (throwaway branch; never merge) =====
+    // num_vals is tuned to the UNPERTURBED degree: the rational fit in
+    // RationalConstraintsOnEquations solves for deg f <= 2g+2, i.e. 2g+4 unknowns, and 2g+5
+    // points give it one spare.  Under an even correction f picks up a factor with divisor
+    // amt*Z(disc), so its degree GROWS and the same point count cannot fit it -- the system
+    // comes out full row rank and the kernel is empty, which is the "no solution found" error.
+    // CMEXTRA=k asks for k more CM points so the degree question is answerable at all.
+    if GetEnv("CMEXTRA") ne "" then
+        num_vals +:= StringToInteger(GetEnv("CMEXTRA"));
+    end if;
+    // ===== end CMEXTRA =====
     // Note that y^2 may vanish at 2*g+2 CM points, and be infinity at another one (2g+3).
     // We would need two other CM pts to determine the correct scaling, based on the fields of definition.
     t := Realtime();
@@ -985,6 +1016,14 @@ intrinsic AllEquationsAboveCovers(Xstar::ShimuraQuot, curves::SeqEnum[ShimuraQuo
