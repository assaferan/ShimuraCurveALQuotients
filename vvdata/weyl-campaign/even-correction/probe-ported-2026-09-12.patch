@@ -710,6 +727,21 @@ intrinsic SchoferFormula(fs::SeqEnum[RngSerLaurElt], d::RngIntElt, Q::AlgMatElt,
 
     // rescaling
 
+    // ===== PROBE_SCALE (throwaway) =====
