*.sig
*.m~
*.el
*.html
.DS_Store

# parallel-pipeline run scratch (chunks/logs/status); keep curves_after_*.dat trackable
data/par_run/parallel_chunks_*/
data/par_run/*.log
data/par_run/STATUS.txt
data/par_run/_statuswriter.sh
data/par/
data/par256/
data/par.*
# local Claude Code agent config
.claude/
polymake/nmzsolve.err

# Python bytecode (py_compile/pytest artifacts; never source)
__pycache__/
*.pyc

# BFCACHE=1 writes saved Borcherds forms here.  Ignored by default because an entry is specific to
# one configuration signature and a stray one is noise -- but an entry for an EXPENSIVE base is
# worth sharing, so add it deliberately with `git add -f BorcherdsForms/<entry>`.  Unlike the
# polymake cache, a bad entry cannot poison a run silently: every hit is verified against the
# stored divisor before use (see GetBorcherdsForms in BorcherdsForms.m).
BorcherdsForms/
